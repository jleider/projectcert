{
  "name": "projectcert",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Atlas of U.S. state EL teacher certification requirements",
  "scripts": {
    "dev": "astro dev",
    "build": "tsx scripts/check-state-integrity.ts && tsx scripts/generate-llms-full.ts && astro check --minimumFailingSeverity hint && astro build && cp dist/sitemap-index.xml dist/sitemap.xml && tsx scripts/check-built-pages.ts",
    "generate:llms": "tsx scripts/generate-llms-full.ts",
    "preview": "astro preview",
    "astro": "astro",
    "seed": "tsx scripts/seed-from-paper.ts",
    "check:contrast": "tsx scripts/check-contrast.ts",
    "check:integrity": "tsx scripts/check-state-integrity.ts",
    "check:links": "tsx scripts/check-external-links.ts",
    "lint": "eslint .",
    "validate": "astro check --minimumFailingSeverity hint && npm run check:contrast && npm run check:integrity",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "typecheck": "astro sync && tsc --noEmit"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.9",
    "@astrojs/sitemap": "^3.7.2",
    "@astrojs/svelte": "^8.1.0",
    "@fontsource-variable/ibm-plex-sans": "^5.2.8",
    "@fontsource/ibm-plex-mono": "^5.2.7",
    "@fontsource/ibm-plex-serif": "^5.2.7",
    "astro": "^6.3.1",
    "autoprefixer": "^10.5.0",
    "d3-geo": "^3.1.1",
    "postcss": "^8.5.14",
    "svelte": "^5.55.5",
    "tailwindcss": "^3.4.19",
    "topojson-client": "^3.1.0",
    "typescript": "^5.9.3",
    "us-atlas": "^3.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.59.1",
    "@types/d3-geo": "^3.1.0",
    "@types/node": "^25.6.2",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-simplify": "^3.0.3",
    "axe-core": "^4.11.4",
    "eslint": "^10.3.0",
    "eslint-plugin-astro": "^1.7.0",
    "eslint-plugin-svelte": "^3.17.1",
    "svelte-eslint-parser": "^1.6.1",
    "topojson-simplify": "^3.0.3",
    "tsx": "^4.21.0",
    "typescript-eslint": "^8.59.2",
    "vitest": "^4.1.5"
  }
}
