{
  "name": "projectcert",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Atlas of U.S. state EL teacher certification requirements",
  "scripts": {
    "dev": "astro dev",
    "build": "tsx scripts/check-state-integrity.ts && tsx scripts/generate-llms-full.ts && astro check --minimumFailingSeverity hint && astro build && cp dist/sitemap-index.xml dist/sitemap.xml && tsx scripts/check-built-pages.ts && tsx scripts/check-discovery-surfaces.ts",
    "generate:llms": "tsx scripts/generate-llms-full.ts",
    "preview": "astro preview",
    "astro": "astro",
    "seed": "tsx scripts/seed-from-paper.ts",
    "check:contrast": "tsx scripts/check-contrast.ts",
    "check:integrity": "tsx scripts/check-state-integrity.ts",
    "check:links": "tsx scripts/check-external-links.ts",
    "check:deadcode": "knip",
    "check:discovery": "tsx scripts/check-discovery-surfaces.ts",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "check:format": "prettier --check .",
    "validate": "astro check --minimumFailingSeverity hint && npm run check:contrast && npm run check:integrity",
    "verify": "npm run check:format && npm run lint && npm run typecheck && npm run validate && npm run test && npm run build",
    "test": "NODE_OPTIONS=--disable-warning=ExperimentalWarning vitest run",
    "test:e2e": "playwright test",
    "e2e:audit": "node tests/e2e/audit-console.e2e.mjs",
    "typecheck": "astro sync && tsc --noEmit && tsc -p functions/tsconfig.json && tsc -p tsconfig.tests.json",
    "dev:pages": "wrangler pages dev dist --binding DEV_REVIEWER_EMAIL=dev@local",
    "d1:migrate:local": "wrangler d1 migrations apply projectcert-audit --local",
    "d1:migrate:remote": "wrangler d1 migrations apply projectcert-audit --remote"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/sitemap": "^3.7.3",
    "@astrojs/svelte": "^8.1.2",
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-serif": "^5.3.0",
    "astro": "^6.4.7",
    "autoprefixer": "^10.5.4",
    "d3-geo": "^3.1.1",
    "postcss": "^8.5.26",
    "svelte": "^5.56.9",
    "tailwindcss": "^3.4.19",
    "topojson-client": "^3.1.0",
    "typescript": "^6.0.3",
    "us-atlas": "^3.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@cloudflare/workers-types": "^5.20260816.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@types/d3-geo": "^3.1.1",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^25.6.2",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-simplify": "^3.0.3",
    "@types/topojson-specification": "^1.0.5",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^1.7.0",
    "eslint-plugin-svelte": "^3.23.0",
    "jose": "^6.2.9",
    "knip": "^6.32.2",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte-eslint-parser": "^1.8.1",
    "topojson-simplify": "^3.0.3",
    "tsx": "^4.23.12",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.10",
    "wrangler": "^4.123.0"
  }
}
