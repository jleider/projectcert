---
/**
 * "Cite this page" block — three formats side-by-side (APA, BibTeX,
 * plain text) for both human researchers and LLM/RAG systems lifting
 * a citation verbatim.
 *
 * Every block also surfaces the Leider et al. (2021) seed-paper
 * citation. The dataset extends that paper and any use of projectcert
 * data is expected to cite both: the per-page or per-dataset entry
 * (for the as-of date and the specific URL) AND the underlying
 * paper (for the original taxonomy and 2019 baseline coding).
 */

interface Props {
  /** e.g., "Texas EL teacher certification" or "projectcert: U.S. EL teacher certification atlas" */
  title: string;
  /** ISO date — used for retrieval/access date. */
  dateModified: string;
  /** Absolute URL of the page being cited. */
  url: string;
  /** BibTeX key — alphanumeric only, no spaces. */
  bibKey: string;
  /** Optional DOI when one exists. Add this once the Zenodo DOI is minted. */
  doi?: string;
}

const { title, dateModified, url, bibKey, doi } = Astro.props;

const year = dateModified.slice(0, 4);

function formatLongDate(iso: string): string {
  const [y, m, d] = iso.split("-");
  const date = new Date(Date.UTC(Number(y), Number(m) - 1, Number(d)));
  return date.toLocaleDateString("en-US", {
    year: "numeric",
    month: "long",
    day: "numeric",
    timeZone: "UTC",
  });
}

const accessed = formatLongDate(dateModified);

const apaSelf = doi
  ? `projectcert. (${year}). ${title}. https://doi.org/${doi}`
  : `projectcert. (${year}). ${title}. Retrieved ${accessed}, from ${url}`;

const apaSeed = `Leider, C. M., Colombo, M. W., & Nerlino, E. (2021). Decentralization, teacher quality, and the education of English learners: Do state education agencies effectively prepare teachers of ELs? Education Policy Analysis Archives, 29(100). https://doi.org/10.14507/epaa.29.5279`;

const bibtexSelf = `@misc{${bibKey},
  author = {{projectcert}},
  title  = {{${title}}},
  year   = {${year}},
  url    = {${url}}${doi ? `,\n  doi    = {${doi}}` : ""},
  note   = {Last verified ${dateModified}}
}`;

const bibtexSeed = `@article{leider2021decentralization,
  author  = {Leider, Christine M. and Colombo, Michaela W. and Nerlino, Erika},
  title   = {{Decentralization, teacher quality, and the education of English learners: Do state education agencies effectively prepare teachers of ELs?}},
  journal = {Education Policy Analysis Archives},
  volume  = {29},
  number  = {100},
  year    = {2021},
  doi     = {10.14507/epaa.29.5279}
}`;

const plainSelf = `projectcert. ${title}. Last verified ${dateModified}. ${url}${doi ? ` (doi:${doi})` : ""}`;
const plainSeed = `Leider, Colombo & Nerlino. 2021. Decentralization, teacher quality, and the education of English learners. Education Policy Analysis Archives 29(100). doi:10.14507/epaa.29.5279`;
---

<section
  id="cite-this-page"
  class="mt-10 scroll-mt-20 rounded border border-ink-subtle/20 bg-surface-raised p-4"
  aria-labelledby="cite-heading"
>
  <h2 id="cite-heading" class="text-base font-semibold text-ink">
    Cite this page
  </h2>
  <p class="mt-1 text-xs text-ink-subtle">
    Site content is published under <a class="text-accent hover:underline" href="https://creativecommons.org/licenses/by/4.0/" target="_blank" rel="noopener noreferrer">CC BY 4.0</a>.
    <strong class="font-semibold text-ink">When citing a fact from this page, please cite both projectcert <em>and</em> the original Leider et&nbsp;al. (2021) paper</strong> the dataset extends.
  </p>

  <dl class="mt-4 space-y-5 text-sm">
    <div>
      <dt class="text-xs font-mono uppercase tracking-wide text-ink-subtle">APA</dt>
      <dd class="mt-1 text-ink space-y-2">
        <pre class="whitespace-pre-wrap font-sans text-sm">{apaSelf}</pre>
        <pre class="whitespace-pre-wrap font-sans text-sm">{apaSeed}</pre>
      </dd>
    </div>
    <div>
      <dt class="text-xs font-mono uppercase tracking-wide text-ink-subtle">BibTeX</dt>
      <dd class="mt-1 text-ink space-y-2">
        <pre class="overflow-x-auto whitespace-pre rounded bg-surface p-3 text-xs leading-relaxed">{bibtexSelf}</pre>
        <pre class="overflow-x-auto whitespace-pre rounded bg-surface p-3 text-xs leading-relaxed">{bibtexSeed}</pre>
      </dd>
    </div>
    <div>
      <dt class="text-xs font-mono uppercase tracking-wide text-ink-subtle">Plain text</dt>
      <dd class="mt-1 text-ink space-y-2">
        <pre class="whitespace-pre-wrap font-sans text-sm">{plainSelf}</pre>
        <pre class="whitespace-pre-wrap font-sans text-sm">{plainSeed}</pre>
      </dd>
    </div>
  </dl>
</section>
