---
import type { State } from "@/content.config";

interface Props {
  /**
   * Stable DOM id for the panel heading. Passed in rather than derived
   * from `title`: the title is a state-local credential name that carries
   * spaces and parentheses ("English as a New Language (ENL)"), and an id
   * built from it both breaks `aria-labelledby` — which splits on
   * whitespace into a list of IDREFs, matching nothing — and produces an
   * id no CSS or `querySelector` can address.
   */
  headingId: string;
  title: string;
  credential: State["credentials"]["bilingual"] | State["credentials"]["eld"];
  showLanguage?: boolean;
}

const { headingId, title, credential, showLanguage = false } = Astro.props;

function flag(v: boolean | null | undefined): string {
  if (v === true) return "Required";
  if (v === false) return "Not required";
  return "Unknown";
}

function flagClass(v: boolean | null | undefined): string {
  if (v === true) return "text-accent";
  if (v === false) return "text-ink-subtle";
  return "text-ink-subtle italic";
}
---

<section class="rounded border border-ink-subtle/20 p-4" aria-labelledby={headingId}>
  <h3 id={headingId} class="text-base font-semibold text-ink">{title}</h3>

  {!credential.offered && <p class="mt-2 text-ink-muted">Not offered.</p>}

  {
    credential.offered && (
      <>
        <ul class="mt-2 flex flex-wrap gap-2 text-sm" aria-label="Available credential pathways">
          {credential.standalone && (
            <li class="inline-flex items-center rounded-full border border-accent/40 bg-accent/5 px-2.5 py-0.5 text-accent">
              Standalone certification
            </li>
          )}
          {credential.addOn && (
            <li class="inline-flex items-center rounded-full border border-accent/40 bg-accent/5 px-2.5 py-0.5 text-accent">
              Add-on endorsement
            </li>
          )}
        </ul>

        {credential.requirements && (
          <dl class="mt-3 grid grid-cols-2 gap-x-4 gap-y-1 text-sm">
            <dt class="text-ink-muted">Approved program</dt>
            <dd class={flagClass(credential.requirements.program)}>{flag(credential.requirements.program)}</dd>
            <dt class="text-ink-muted">Coursework</dt>
            <dd class={flagClass(credential.requirements.coursework)}>{flag(credential.requirements.coursework)}</dd>
            <dt class="text-ink-muted">Practicum</dt>
            <dd class={flagClass(credential.requirements.practicum)}>{flag(credential.requirements.practicum)}</dd>
            <dt class="text-ink-muted">Subject test</dt>
            <dd class={flagClass(credential.requirements.test)}>{flag(credential.requirements.test)}</dd>
            {showLanguage && (
              <>
                <dt class="text-ink-muted">Language proficiency</dt>
                <dd class={flagClass(credential.requirements.languageProficiency)}>
                  {flag(credential.requirements.languageProficiency)}
                </dd>
              </>
            )}
          </dl>
        )}
      </>
    )
  }

  {credential.notes && <p class="mt-3 text-sm text-ink-muted italic">{credential.notes}</p>}
</section>
