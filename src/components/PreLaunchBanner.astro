---
import { ROUTES } from "@/lib/routes";

interface Props {
  verified: number;
  total: number;
}

const { verified, total } = Astro.props;
const launched = verified === total;
---

{!launched && (
  <div class="bg-surface-warn border-b border-ink-subtle/30">
    <div class="max-w-6xl mx-auto px-4 py-2 text-sm text-ink flex flex-wrap gap-x-4 gap-y-1 items-center justify-between">
      <p>
        <strong>Pre-launch.</strong>
        {" "}
        {verified} of {total} states verified against current SEA sources.
        Remaining states show 2019 baseline data from the seed paper.
      </p>
      <a href={ROUTES.verification} class="text-accent hover:underline whitespace-nowrap">
        View progress →
      </a>
    </div>
  </div>
)}
