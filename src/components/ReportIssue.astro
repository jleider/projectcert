---
import ExternalLink from "@/components/ExternalLink.astro";
import { buildFeedbackUrl } from "@/config/feedback";

interface Props {
  state?: string;
  pageType?: string;
  verificationStatus?: string;
  variant?: "footer" | "inline";
  class?: string;
}

const {
  state,
  pageType,
  verificationStatus,
  variant = "footer",
  class: className = "",
} = Astro.props;

const pageUrl = Astro.url.toString();
const href = buildFeedbackUrl({ pageUrl, state, pageType, verificationStatus });
---

{href && variant === "footer" && (
  <ExternalLink class={`text-accent hover:underline ${className}`} href={href}>
    Report a data issue
  </ExternalLink>
)}

{href && variant === "inline" && (
  <aside class={`mt-8 rounded border border-ink-subtle/20 bg-surface-raised p-4 ${className}`}>
    <h2 class="text-base font-semibold text-ink">Spot something incorrect?</h2>
    <p class="mt-1 text-sm text-ink-muted">
      We re-verify every state against current SEA sources, but agencies update
      their pages regularly. If a fact, citation, or terminology choice on this
      page looks wrong, please flag it &mdash; corrections from researchers,
      practitioners, and SEA staff are welcome.
    </p>
    <p class="mt-3 text-sm">
      <ExternalLink
        class="inline-block rounded bg-accent px-3 py-1.5 font-semibold text-surface hover:opacity-90"
        href={href}
        hideIcon={true}
      >
        Report a data issue on this page &rarr;
      </ExternalLink>
    </p>
  </aside>
)}
