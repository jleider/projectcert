---
/**
 * Renders share buttons for X, Bluesky, Facebook, and LinkedIn.
 */
import ExternalLink from "@/components/ExternalLink.astro";

interface Props {
  url: string;
  text: string;
  variant?: "footer" | "inline";
  class?: string;
}

const { url, text, variant = "inline", class: className = "" } = Astro.props;

const u = encodeURIComponent(url);
const t = encodeURIComponent(text);
const tWithUrl = encodeURIComponent(`${text} ${url}`);

const links: Array<{ name: string; href: string; svg: string }> = [
  {
    name: "X",
    href: `https://x.com/intent/post?text=${t}&url=${u}`,
    svg: `<path d="M18.244 2H21l-6.51 7.44L22 22h-6.84l-4.78-6.25L4.8 22H2.04l6.96-7.96L2 2h6.99l4.32 5.71L18.244 2Zm-1.2 18h1.86L7.04 4H5.06l11.984 16Z"/>`,
  },
  {
    name: "Bluesky",
    href: `https://bsky.app/intent/compose?text=${tWithUrl}`,
    svg: `<path d="M6.335 5.144c2.59 1.943 5.376 5.882 6.4 7.996.001-.001.002-.001.003 0 1.024-2.114 3.81-6.053 6.4-7.996 1.871-1.404 4.902-2.49 4.902.97 0 .69-.396 5.808-.628 6.64-.808 2.892-3.756 3.628-6.378 3.182 4.585.78 5.752 3.367 3.234 5.953-4.78 4.911-6.871-1.232-7.407-2.804-.099-.288-.144-.422-.145-.308-.001-.114-.046.02-.144.308-.537 1.572-2.628 7.715-7.408 2.804-2.518-2.586-1.351-5.173 3.234-5.953-2.622.446-5.57-.29-6.378-3.182C1.789 11.922 1.393 6.804 1.393 6.114c0-3.46 3.031-2.374 4.902-.97h.04Z"/>`,
  },
  {
    name: "Facebook",
    href: `https://www.facebook.com/sharer/sharer.php?u=${u}`,
    svg: `<path d="M22 12.06C22 6.503 17.523 2 12 2S2 6.503 2 12.06c0 5.022 3.657 9.184 8.438 9.94v-7.03H7.898v-2.91h2.54V9.845c0-2.522 1.492-3.915 3.777-3.915 1.094 0 2.238.197 2.238.197v2.476h-1.26c-1.243 0-1.63.775-1.63 1.57v1.887h2.773l-.443 2.91h-2.33V22c4.78-.756 8.437-4.918 8.437-9.94Z"/>`,
  },
  {
    name: "LinkedIn",
    href: `https://www.linkedin.com/sharing/share-offsite/?url=${u}`,
    svg: `<path d="M20.452 20.452h-3.554v-5.569c0-1.328-.024-3.037-1.852-3.037-1.853 0-2.136 1.447-2.136 2.94v5.666H9.355V9h3.414v1.561h.05c.476-.9 1.637-1.85 3.37-1.85 3.601 0 4.265 2.37 4.265 5.455v6.286h-.002ZM5.337 7.433a2.062 2.062 0 0 1-2.062-2.062 2.062 2.062 0 1 1 2.062 2.062Zm1.78 13.019H3.553V9h3.564v11.452ZM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451c.978 0 1.778-.773 1.778-1.729V1.729C24 .774 23.2 0 22.222 0h.003Z"/>`,
  },
];

const inlineBtnClass =
  "inline-flex items-center gap-1.5 rounded border border-ink-subtle/20 bg-surface px-3 py-1.5 text-sm text-ink hover:border-accent hover:text-accent";
const footerBtnClass = "inline-flex items-center gap-1 text-sm text-ink-muted hover:text-accent";
---

{
  variant === "inline" && (
    <aside class={`mt-8 rounded border border-ink-subtle/20 bg-surface-raised p-4 ${className}`}>
      <h2 class="text-base font-semibold text-ink">Share this page</h2>
      <p class="mt-1 text-sm text-ink-muted">
        Help researchers, teacher educators, and policymakers find this catalog.
      </p>
      <ul class="mt-3 flex flex-wrap gap-2">
        {links.map((l) => (
          <li>
            <ExternalLink href={l.href} class={inlineBtnClass} hideIcon={true}>
              <svg
                aria-hidden="true"
                focusable="false"
                viewBox="0 0 24 24"
                width="14"
                height="14"
                fill="currentColor"
                set:html={l.svg}
              />
              {l.name}
            </ExternalLink>
          </li>
        ))}
      </ul>
    </aside>
  )
}

{
  variant === "footer" && (
    <ul class={`flex flex-wrap gap-3 ${className}`}>
      {links.map((l) => (
        <li>
          <ExternalLink href={l.href} class={footerBtnClass} hideIcon={true}>
            <svg
              aria-hidden="true"
              focusable="false"
              viewBox="0 0 24 24"
              width="14"
              height="14"
              fill="currentColor"
              set:html={l.svg}
            />
            <span>{l.name}</span>
          </ExternalLink>
        </li>
      ))}
    </ul>
  )
}
