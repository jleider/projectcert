---
interface Props {
  /** USPS code (case-insensitive). */
  usps: string;
  /** Square render size in px. */
  size?: number;
  /** Extra classes appended to the wrapper. */
  class?: string;
}

const { usps, size = 64, class: className = "" } = Astro.props;
const src = `/seals/${usps.toLowerCase()}.svg`;
---

<span
  class={`shrink-0 inline-flex items-center justify-center ${className}`}
  style={`width: ${size}px; height: ${size}px;`}
  aria-hidden="false"
>
  <img
    src={src}
    alt={`${usps} state seal`}
    loading="lazy"
    decoding="async"
    style={`max-width: 100%; max-height: 100%; width: auto; height: auto; object-fit: contain;`}
  />
</span>
