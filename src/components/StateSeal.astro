---
interface Props {
  /** USPS code (case-insensitive). */
  usps: string;
  /** Square render size in px. */
  size?: number;
  /** Extra classes appended to the wrapper. */
  class?: string;
}

const { usps, size = 64, class: className = "" } = Astro.props;
const src = `/seals/${usps.toLowerCase()}.svg`;
---

<span
  role="img"
  aria-label={`${usps} state seal`}
  class={`shrink-0 inline-block ${className}`}
  style={`width: ${size}px; height: ${size}px; background-image: url('${src}'); background-size: contain; background-position: center; background-repeat: no-repeat;`}
></span>
