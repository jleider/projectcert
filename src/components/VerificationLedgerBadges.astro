---
/**
 * Public, additive signal of independent review activity, distinct from
 * the curated `verificationStatus` badge. Reads the ledger that the
 * nightly sync Action exports from the review console's data store. When
 * the ledger has no entry for a state (the default), nothing renders.
 */
import ledgerData from "@/data/verification-ledger.json";

interface LedgerEntry {
  verified: string[];
  verifiedAt: Record<string, string>;
  count: number;
  total: number;
  stale: string[];
}

interface Props {
  usps: string;
}

const { usps } = Astro.props;
const ledger = ledgerData as Record<string, LedgerEntry>;
const entry = ledger[usps];

const dates = entry ? Object.values(entry.verifiedAt) : [];
const lastReviewed = dates.length > 0 ? dates.reduce((a, b) => (a > b ? a : b)).slice(0, 10) : null;
---

{
  entry && entry.count > 0 && (
    <span
      class="inline-flex items-center gap-1 rounded-full border border-accent/40 bg-accent/5 px-2.5 py-0.5 text-xs text-accent"
      title={
        lastReviewed
          ? `${entry.count} of ${entry.total} datapoints independently reviewed against current sources; most recent on ${lastReviewed}.`
          : `${entry.count} of ${entry.total} datapoints independently reviewed against current sources.`
      }
    >
      {entry.count} of {entry.total} datapoints reviewed
      {lastReviewed && <span class="text-ink-subtle"> · {lastReviewed}</span>}
    </span>
  )
}
