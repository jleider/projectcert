---
import "@fontsource-variable/ibm-plex-sans/wght.css";
import "@fontsource-variable/ibm-plex-sans/wght-italic.css";
import "@fontsource/ibm-plex-serif/400.css";
import "@fontsource/ibm-plex-serif/400-italic.css";
import "@fontsource/ibm-plex-serif/700.css";
import "@fontsource/ibm-plex-serif/700-italic.css";
import "@fontsource/ibm-plex-mono/400.css";
import "@fontsource/ibm-plex-mono/700.css";
import "@/styles/tokens.css";
import ExternalLink from "@/components/ExternalLink.astro";
import ReportIssue from "@/components/ReportIssue.astro";
import JsonLd from "@/components/JsonLd.astro";
import { FEEDBACK_FORM } from "@/config/feedback";
import { SITE_URL, SITE_NAME, WEB_ANALYTICS_TOKEN } from "@/config/site";
import { ROUTES, ANCHORS, sameAnchor, withAnchor } from "@/lib/routes";

/**
 * Google Scholar discovery metadata. Scholar's crawler builds its
 * search index off `<meta name="citation_*">` tags, not OG or JSON-LD.
 * Set on pages that constitute a citable artifact (state records,
 * credential reports, the homepage dataset). Per Scholar's HTML inclusion
 * guidelines: title, author, publication_date, and public_url are
 * required; doi is recommended once minted; multiple `citation_author`
 * tags are emitted when `authors` has >1 entry.
 *
 * https://scholar.google.com/intl/en/scholar/inclusion.html#indexing
 */
export interface CitationMeta {
  title: string;
  /** Defaults to ["projectcert"] (matches the existing CitationBlock convention). */
  authors?: string[];
  /** YYYY-MM-DD; Scholar accepts the dashed form. */
  publicationDate: string;
  /** Absolute URL of the citable page. Defaults to the canonical URL. */
  publicUrl?: string;
  /** Once the Zenodo DOI is minted, pass it here so it propagates into citation_doi too. */
  doi?: string;
}

interface Props {
  title: string;
  description?: string;
  /** OG type. "article" for state/credential/methodology pages, default "website". */
  type?: "website" | "article";
  /** ISO 8601 modified time, surfaced as `article:modified_time`. */
  modifiedTime?: string;
  /** ISO 8601 published time. */
  publishedTime?: string;
  /** Absolute or root-relative URL of the OG image; falls back to og-default.png. */
  image?: string;
  /** Per-page JSON-LD (Dataset, Article, etc.). The site-level Organization + WebSite is always emitted. */
  jsonLd?: Record<string, unknown> | Array<Record<string, unknown>>;
  /** Google Scholar discovery metadata. Omit on non-citable pages (404, embed). */
  citation?: CitationMeta;
}

const { title, description, type = "website", modifiedTime, publishedTime, image, jsonLd, citation } = Astro.props;

const fullTitle = `${title} — ${SITE_NAME}`;
const canonicalUrl = new URL(Astro.url.pathname, SITE_URL).toString();
const ogImage = new URL(image ?? "/og-default.png", SITE_URL).toString();

const siteJsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "@id": `${SITE_URL}/#organization`,
    name: SITE_NAME,
    url: SITE_URL,
    description:
      "An atlas of every U.S. state education agency's teacher certification requirements for instructing classified English Learner students.",
  },
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "@id": `${SITE_URL}/#website`,
    url: SITE_URL,
    name: SITE_NAME,
    inLanguage: "en-US",
    publisher: { "@id": `${SITE_URL}/#organization` },
    license: "https://creativecommons.org/licenses/by/4.0/",
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonicalUrl} />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
    <meta name="theme-color" content="#3d1971" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#262833" media="(prefers-color-scheme: dark)" />
    <link rel="license" href="https://creativecommons.org/licenses/by/4.0/" title="CC BY 4.0" />

    <!-- Open Graph -->
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={fullTitle} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="en_US" />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    {description && <meta name="twitter:description" content={description} />}
    <meta name="twitter:image" content={ogImage} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    {
      citation && (
        <>
          <meta name="citation_title" content={citation.title} />
          {(citation.authors ?? ["projectcert"]).map((a) => (
            <meta name="citation_author" content={a} />
          ))}
          <meta name="citation_publication_date" content={citation.publicationDate} />
          <meta name="citation_public_url" content={citation.publicUrl ?? canonicalUrl} />
          {citation.doi && <meta name="citation_doi" content={citation.doi} />}
        </>
      )
    }

    <JsonLd data={siteJsonLd} />
    {jsonLd && <JsonLd data={jsonLd} />}

    {
      /* Cloudflare Web Analytics — cookieless, so no consent banner is
        required, though the privacy policy still applies because IP
        addresses are processed. Only public pages carry it: the gated
        console uses AuditLayout and the iframe embed uses EmbedLayout,
        so reviewers are not measured and the embed does not beacon from
        a third party's page. `is:inline` keeps Astro from bundling a
        script that must load from Cloudflare's own origin. */
    }
    {
      WEB_ANALYTICS_TOKEN && (
        <script
          is:inline
          type="module"
          src="https://static.cloudflareinsights.com/beacon.min.js"
          data-cf-beacon={JSON.stringify({ token: WEB_ANALYTICS_TOKEN })}
        />
      )
    }
  </head>
  <body class="min-h-screen flex flex-col">
    <a href={sameAnchor(ANCHORS.main)} class="skip-link">Skip to main content</a>

    <header class="border-b border-ink-subtle/15 bg-surface">
      <div class="max-w-6xl mx-auto px-4 py-3 flex items-center justify-between flex-wrap gap-3">
        <a
          href={ROUTES.home}
          class="flex items-center gap-2 font-semibold text-ink hover:text-accent"
          aria-label="projectcert — home"
        >
          <svg width="28" height="28" viewBox="0 0 32 32" aria-hidden="true" focusable="false">
            <rect x="2" y="2" width="13" height="13" rx="2.5" fill="var(--bin-0)"></rect>
            <rect x="17" y="2" width="13" height="13" rx="2.5" fill="var(--bin-1)"></rect>
            <rect x="2" y="17" width="13" height="13" rx="2.5" fill="var(--bin-2)"></rect>
            <rect x="17" y="17" width="13" height="13" rx="2.5" fill="var(--bin-3)"></rect>
            <path
              d="M20.25 24.25 L23 27 L27.75 21.5"
              fill="none"
              stroke="var(--surface)"
              stroke-width="2.4"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
          <span>project<span style="color: var(--brand)">cert</span></span>
        </a>
        <nav aria-label="Primary">
          <ul class="flex flex-wrap gap-x-4 gap-y-1 text-sm text-ink-muted">
            <li>
              <a href={ROUTES.map} class="hover:text-accent focus-visible:text-accent">Map</a>
            </li>
            <li>
              <a href={ROUTES.credentials.bilingual} class="hover:text-accent focus-visible:text-accent">Credentials</a>
            </li>
            <li>
              <a href={ROUTES.compare} class="hover:text-accent focus-visible:text-accent">Compare</a>
            </li>
            <li>
              <a href={ROUTES.methodology} class="hover:text-accent focus-visible:text-accent">Methodology</a>
            </li>
            <li>
              <a href={ROUTES.glossary} class="hover:text-accent focus-visible:text-accent">Glossary</a>
            </li>
            <li>
              <a href={ROUTES.about} class="hover:text-accent focus-visible:text-accent">About</a>
            </li>
          </ul>
        </nav>
      </div>
    </header>

    <main id={ANCHORS.main} class="flex-1">
      <slot />
    </main>

    <footer class="mt-16 border-t border-ink-subtle/15 bg-surface-raised text-sm text-ink-muted">
      <div class="max-w-6xl mx-auto px-4 py-6 flex flex-wrap gap-4 justify-between">
        <p>
          Seed data: <ExternalLink class="text-accent hover:underline" href="https://doi.org/10.14507/epaa.29.5279"
            >Leider, Colombo &amp; Nerlino (2021), <em>EPAA</em> 29(100)</ExternalLink
          >. If you use data from this site, please <a
            class="text-accent hover:underline"
            href={withAnchor(ROUTES.about, ANCHORS.howToCite)}>cite the authors</a
          >.
        </p>
        <p>
          <a class="text-accent hover:underline" href={ROUTES.verification}>Verification status</a>
          {" · "}
          <a class="text-accent hover:underline" href={withAnchor(ROUTES.about, ANCHORS.howToCite)}>How to cite</a>
          {" · "}
          <a class="text-accent hover:underline" href={ROUTES.methodology}>Methodology</a>
          {
            FEEDBACK_FORM.baseUrl && (
              <>
                {" · "}
                <ReportIssue variant="footer" />
              </>
            )
          }
        </p>
      </div>
    </footer>
  </body>
</html>
