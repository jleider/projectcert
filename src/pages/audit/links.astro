---
import AuditLayout from "@/layouts/AuditLayout.astro";
import AuditLinkReview from "@/components/AuditLinkReview.svelte";
import { ROUTES } from "@/lib/routes";
---

<AuditLayout title="Link review">
  <nav class="text-sm text-ink-muted">
    <a href={ROUTES.audit} class="hover:text-accent">All states</a>
    <span aria-hidden="true"> / </span>
    <span class="text-ink">Link review</span>
  </nav>

  <h1 class="mt-2 text-2xl font-bold text-ink">Bot-blocked link review</h1>
  <p class="mt-2 text-sm text-ink-muted max-w-3xl">
    The weekly link sweep flags cited URLs that reject automated requests (HTTP 401, 403, 405, or 429). These are not
    necessarily broken — many State Education Agency sites block bots while serving the page normally in a browser. Open
    each URL; if it loads, accept it. Accepted URLs are added to the checker's whitelist and stop being flagged.
  </p>

  <AuditLinkReview client:load />
</AuditLayout>
