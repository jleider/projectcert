---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Choropleth from "@/components/Choropleth.svelte";
import ChoroplethLegend from "@/components/ChoroplethLegend.astro";
import StateLink from "@/components/StateLink.astro";
import ShareLinks from "@/components/ShareLinks.astro";
import { getAllStates, getChoroplethData, breakdownFor } from "@/lib/state-data";
import { SITE_URL } from "@/config/site";
import { breadcrumbWithHome } from "@/lib/jsonld";

const states = await getAllStates();
const data = await getChoroplethData();

const { offered, standalone, addOnOnly, both, notOffered } = breakdownFor(states, "bilingual");
const requiresProgram = offered.filter(
  (s) => s.credentials.bilingual.requirements?.program === true,
);
const requiresLanguage = offered.filter(
  (s) => s.credentials.bilingual.requirements?.languageProficiency === true,
);

const pageUrl = `${SITE_URL}/credentials/bilingual/`;
const credentialJsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Article",
    headline: "Bilingual education credential — by state",
    description: `Cross-state report on bilingual teaching credentials. ${offered.length} of 51 SEAs offer a bilingual credential; ${standalone.length} as a standalone certification, ${addOnOnly.length} only as an add-on endorsement, ${both.length} on both pathways.`,
    url: pageUrl,
    inLanguage: "en-US",
    publisher: { "@id": `${SITE_URL}/#organization` },
    isAccessibleForFree: true,
  },
  breadcrumbWithHome([
    { name: "Credentials", url: "/credentials/bilingual/" },
    { name: "Bilingual", url: pageUrl },
  ]),
];
---

<BaseLayout
  title="Bilingual education credential — by state"
  description="Which states offer a bilingual education teaching credential, and what does earning one require?"
  type="article"
  jsonLd={credentialJsonLd}
>
  <article class="max-w-5xl mx-auto px-4 py-8">
    <p class="text-sm text-ink-muted">
      <a href="/" class="text-accent hover:underline">Home</a> / Credentials /
      <span aria-current="page">Bilingual</span>
    </p>

    <h1 class="mt-2 text-3xl font-bold text-ink">Bilingual education credential</h1>
    <p class="mt-3 text-lg text-ink-muted max-w-3xl">
      Bilingual education credentials authorize teachers to deliver
      content instruction in a language other than English. Despite a
      research base associating bilingual programs with the strongest
      academic outcomes for classified ELs, the credential is not
      universally available across states.
    </p>

    <ul class="mt-8 grid grid-cols-2 sm:grid-cols-4 gap-3 text-sm">
      <li class="rounded border border-ink-subtle/20 p-4">
        <div class="text-2xl font-bold text-ink">{offered.length}<span class="text-ink-subtle">/51</span></div>
        <div class="text-ink-muted">states offer the credential</div>
      </li>
      <li class="rounded border border-ink-subtle/20 p-4">
        <div class="text-2xl font-bold text-ink">{standalone.length}</div>
        <div class="text-ink-muted">offer it as a standalone certification</div>
      </li>
      <li class="rounded border border-ink-subtle/20 p-4">
        <div class="text-2xl font-bold text-ink">{addOnOnly.length}</div>
        <div class="text-ink-muted">offer add-on only</div>
      </li>
      <li class="rounded border border-ink-subtle/20 p-4">
        <div class="text-2xl font-bold text-ink">{both.length}</div>
        <div class="text-ink-muted">offer both pathways</div>
      </li>
    </ul>

    <div class="mt-10">
      <h2 class="text-xl font-semibold text-ink">Availability by state</h2>
      <div class="mt-4">
        <Choropleth client:only="svelte" states={data} layer="bilingual" />
      </div>
      <div class="mt-3">
        <ChoroplethLegend
          variant="categorical"
          categoricalLabels={{ none: "Not offered", mid: "Add-on only", high: "Standalone offered" }}
        />
      </div>
    </div>

    <section class="mt-12">
      <h2 class="text-xl font-semibold text-ink">Requirements (where add-on)</h2>
      <p class="mt-2 text-ink-muted max-w-3xl">
        Among states with an add-on bilingual endorsement, requirements vary
        substantially. Only {requiresProgram.length} require completion of an
        approved preparation program; only {requiresLanguage.length} require
        demonstrated proficiency in a non-English language.
      </p>

      <div class="mt-4 overflow-x-auto">
        <table class="min-w-full text-sm">
          <thead class="text-left bg-surface-raised">
            <tr>
              <th class="px-3 py-2 font-semibold text-ink">State</th>
              <th class="px-3 py-2 font-semibold text-ink">% EL</th>
              <th class="px-3 py-2 font-semibold text-ink">Standalone</th>
              <th class="px-3 py-2 font-semibold text-ink">Add-on</th>
              <th class="px-3 py-2 font-semibold text-ink">Program</th>
              <th class="px-3 py-2 font-semibold text-ink">Coursework</th>
              <th class="px-3 py-2 font-semibold text-ink">Practicum</th>
              <th class="px-3 py-2 font-semibold text-ink">Test</th>
              <th class="px-3 py-2 font-semibold text-ink">Language</th>
            </tr>
          </thead>
          <tbody>
            {offered.map((s) => {
              const r = s.credentials.bilingual.requirements;
              const flag = (v: boolean | null | undefined) =>
                v === true ? "✓" : v === false ? "—" : "?";
              return (
                <tr class="border-t border-ink-subtle/20">
                  <td class="px-3 py-2"><StateLink usps={s.usps}>{s.name}</StateLink></td>
                  <td class="px-3 py-2 text-ink-muted">{s.elPercent.toFixed(1)}</td>
                  <td class="px-3 py-2">{s.credentials.bilingual.standalone ? "✓" : "—"}</td>
                  <td class="px-3 py-2">{s.credentials.bilingual.addOn ? "✓" : "—"}</td>
                  <td class="px-3 py-2">{flag(r?.program)}</td>
                  <td class="px-3 py-2">{flag(r?.coursework)}</td>
                  <td class="px-3 py-2">{flag(r?.practicum)}</td>
                  <td class="px-3 py-2">{flag(r?.test)}</td>
                  <td class="px-3 py-2">{flag(r?.languageProficiency)}</td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
    </section>

    <section class="mt-10">
      <h2 class="text-xl font-semibold text-ink">States not offering a bilingual credential</h2>
      <p class="mt-2 text-ink-muted">{notOffered.length} states do not offer a bilingual education credential at all.</p>
      <ul class="mt-3 flex flex-wrap gap-x-3 gap-y-1 text-sm">
        {notOffered.map((s) => (
          <li><StateLink usps={s.usps}>{s.name}</StateLink></li>
        ))}
      </ul>
    </section>

    <ShareLinks
      url={`${SITE_URL}/credentials/bilingual/`}
      text="Bilingual education credentials in U.S. states — projectcert"
    />
  </article>
</BaseLayout>
