---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Choropleth from "@/components/Choropleth.svelte";
import ChoroplethLegend from "@/components/ChoroplethLegend.astro";
import StateLink from "@/components/StateLink.astro";
import { getAllStates, getChoroplethData, breakdownFor } from "@/lib/state-data";
import { SITE_URL } from "@/config/site";
import { breadcrumbWithHome } from "@/lib/jsonld";

const states = await getAllStates();
const data = await getChoroplethData();

const { offered, standalone, addOnOnly } = breakdownFor(states, "eld");
const testOnly = offered.filter((s) => {
  const r = s.credentials.eld.requirements;
  if (!r) return false;
  return r.test === true && !r.program && !r.coursework && !r.practicum;
});
const requiresProgram = offered.filter(
  (s) => s.credentials.eld.requirements?.program === true,
);

const pageUrl = `${SITE_URL}/credentials/eld/`;
const credentialJsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Article",
    headline: "ELD credential — by state",
    description: `Cross-state report on the English Language Development (ELD/ESL) credential. ${standalone.length} of 51 SEAs offer ELD as a standalone certification; ${addOnOnly.length} only as an add-on endorsement; ${testOnly.length} allow a test-only pathway.`,
    url: pageUrl,
    inLanguage: "en-US",
    publisher: { "@id": `${SITE_URL}/#organization` },
    isAccessibleForFree: true,
  },
  breadcrumbWithHome([
    { name: "Credentials", url: "/credentials/bilingual/" },
    { name: "ELD", url: pageUrl },
  ]),
];
---

<BaseLayout
  title="ELD credential — by state"
  description="All 51 SEAs offer an ELD/ESL credential, but the requirements vary from a state-approved program to passing a single test."
  type="article"
  jsonLd={credentialJsonLd}
>
  <article class="max-w-5xl mx-auto px-4 py-8">
    <p class="text-sm text-ink-muted">
      <a href="/" class="text-accent hover:underline">Home</a> / Credentials /
      <span aria-current="page">ELD</span>
    </p>

    <h1 class="mt-2 text-3xl font-bold text-ink">English Language Development (ELD) credential</h1>
    <p class="mt-3 text-lg text-ink-muted max-w-3xl">
      Every state offers some form of ELD credential — also called ESL,
      ENL, ESOL, TESOL, or CLD depending on the SEA. What varies wildly is
      what earning one requires.
    </p>

    <ul class="mt-8 grid grid-cols-2 sm:grid-cols-4 gap-3 text-sm">
      <li class="rounded border border-ink-subtle/20 p-4">
        <div class="text-2xl font-bold text-ink">{offered.length}<span class="text-ink-subtle">/51</span></div>
        <div class="text-ink-muted">offer some form of ELD credential</div>
      </li>
      <li class="rounded border border-ink-subtle/20 p-4">
        <div class="text-2xl font-bold text-ink">{standalone.length}</div>
        <div class="text-ink-muted">offer a standalone certification</div>
      </li>
      <li class="rounded border border-ink-subtle/20 p-4">
        <div class="text-2xl font-bold text-ink">{addOnOnly.length}</div>
        <div class="text-ink-muted">offer add-on only</div>
      </li>
      <li class="rounded border border-ink-subtle/20 p-4">
        <div class="text-2xl font-bold text-ink">{requiresProgram.length}</div>
        <div class="text-ink-muted">require an approved program</div>
      </li>
    </ul>

    <div class="mt-10">
      <h2 class="text-xl font-semibold text-ink">Availability by state</h2>
      <div class="mt-4">
        <Choropleth client:only="svelte" states={data} layer="eld" />
      </div>
      <div class="mt-3">
        <ChoroplethLegend
          variant="categorical"
          categoricalLabels={{ none: "Not offered", mid: "Add-on only", high: "Standalone offered" }}
        />
      </div>
    </div>

    {testOnly.length > 0 && (
      <section class="mt-10 rounded border border-bin-2/40 bg-bin-1/20 p-4">
        <h2 class="text-lg font-semibold text-ink">{testOnly.length} states allow earning the credential by test alone</h2>
        <p class="mt-2 text-ink-muted">
          Where coursework, practicum, and an approved program are all
          unrequired and a passing test score is sufficient:
        </p>
        <ul class="mt-2 flex flex-wrap gap-x-3 gap-y-1 text-sm">
          {testOnly.map((s) => (
            <li><StateLink usps={s.usps}>{s.name}</StateLink></li>
          ))}
        </ul>
      </section>
    )}

    <section class="mt-12">
      <h2 class="text-xl font-semibold text-ink">Requirements by state</h2>

      <div class="mt-4 overflow-x-auto">
        <table class="min-w-full text-sm">
          <thead class="text-left bg-surface-raised">
            <tr>
              <th class="px-3 py-2 font-semibold text-ink">State</th>
              <th class="px-3 py-2 font-semibold text-ink">% EL</th>
              <th class="px-3 py-2 font-semibold text-ink">Standalone</th>
              <th class="px-3 py-2 font-semibold text-ink">Add-on</th>
              <th class="px-3 py-2 font-semibold text-ink">Program</th>
              <th class="px-3 py-2 font-semibold text-ink">Coursework</th>
              <th class="px-3 py-2 font-semibold text-ink">Practicum</th>
              <th class="px-3 py-2 font-semibold text-ink">Test</th>
            </tr>
          </thead>
          <tbody>
            {offered.map((s) => {
              const r = s.credentials.eld.requirements;
              const flag = (v: boolean | null | undefined) =>
                v === true ? "✓" : v === false ? "—" : "?";
              return (
                <tr class="border-t border-ink-subtle/20">
                  <td class="px-3 py-2"><StateLink usps={s.usps}>{s.name}</StateLink></td>
                  <td class="px-3 py-2 text-ink-muted">{s.elPercent.toFixed(1)}</td>
                  <td class="px-3 py-2">{s.credentials.eld.standalone ? "✓" : "—"}</td>
                  <td class="px-3 py-2">{s.credentials.eld.addOn ? "✓" : "—"}</td>
                  <td class="px-3 py-2">{flag(r?.program)}</td>
                  <td class="px-3 py-2">{flag(r?.coursework)}</td>
                  <td class="px-3 py-2">{flag(r?.practicum)}</td>
                  <td class="px-3 py-2">{flag(r?.test)}</td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
    </section>
  </article>
</BaseLayout>
