---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Choropleth from "@/components/Choropleth.svelte";
import ChoroplethLegend from "@/components/ChoroplethLegend.astro";
import { getAllStates, getChoroplethData } from "@/lib/state-data";

const states = await getAllStates();
const data = await getChoroplethData();

const mandated = states.filter((s) => s.credentials.sei.mandatedForAllTeachers);
---

<BaseLayout
  title="SEI mandate — by state"
  description="Sheltered English Instruction (SEI) endorsement is mandated for all teachers in only a handful of states."
>
  <article class="max-w-5xl mx-auto px-4 py-8">
    <p class="text-sm text-ink-muted">
      <a href="/" class="text-accent hover:underline">Home</a> / Credentials /
      <span aria-current="page">SEI</span>
    </p>

    <h1 class="mt-2 text-3xl font-bold text-ink">Sheltered English Instruction (SEI) mandate</h1>
    <p class="mt-3 text-lg text-ink-muted max-w-3xl">
      An SEI credential — sometimes called Sheltered English Immersion —
      requires content-area teachers to be trained to make their content
      comprehensible to ELs. Mandating it for <em>all</em> teachers is
      rare.
    </p>

    <ul class="mt-8 grid grid-cols-2 sm:grid-cols-4 gap-3 text-sm">
      <li class="rounded border border-ink-subtle/20 p-4">
        <div class="text-2xl font-bold text-ink">{mandated.length}<span class="text-ink-subtle">/51</span></div>
        <div class="text-ink-muted">states mandate SEI for all teachers</div>
      </li>
      <li class="rounded border border-ink-subtle/20 p-4">
        <div class="text-2xl font-bold text-ink">{(states.length - mandated.length)}<span class="text-ink-subtle">/51</span></div>
        <div class="text-ink-muted">do not</div>
      </li>
    </ul>

    <div class="mt-10">
      <h2 class="text-xl font-semibold text-ink">Mandate by state</h2>
      <div class="mt-4">
        <Choropleth client:only="svelte" states={data} layer="sei" />
      </div>
      <div class="mt-3">
        <ChoroplethLegend variant="binary" binaryLabels={{ off: "Not mandated", on: "Mandated for all teachers" }} />
      </div>
    </div>

    <section class="mt-10">
      <h2 class="text-xl font-semibold text-ink">States with the mandate</h2>
      <ul class="mt-3 space-y-3">
        {mandated.map((s) => (
          <li class="rounded border border-accent/30 bg-accent/5 p-4">
            <a class="font-semibold text-accent hover:underline" href={`/states/${s.usps.toLowerCase()}/`}>{s.name}</a>
            <p class="mt-1 text-sm text-ink-muted">{s.credentials.sei.notes ?? "Mandated for all teachers."}</p>
          </li>
        ))}
      </ul>
    </section>
  </article>
</BaseLayout>
