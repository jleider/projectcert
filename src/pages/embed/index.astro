---
import BaseLayout from "@/layouts/BaseLayout.astro";

const SITE_URL = "https://projectcert.org";

const layers = [
  { value: "elPercent", label: "% classified ELs" },
  { value: "bilingual", label: "Bilingual credential" },
  { value: "eld", label: "ELD credential" },
  { value: "sei", label: "SEI mandate" },
  { value: "standardsMentionsEl", label: "Standards mention ELs" },
  { value: "sealOfBiliteracy", label: "Seal of Biliteracy" },
  { value: "elpAssessment", label: "ELP assessment" },
];

const basicSnippet = `<iframe
  src="${SITE_URL}/embed/map/"
  title="EL teacher certification — projectcert"
  width="100%"
  height="820"
  loading="lazy"
  style="border: 0; max-width: 100%;"
  referrerpolicy="no-referrer-when-downgrade"
></iframe>`;

const responsiveSnippet = `<div style="position: relative; width: 100%; padding-bottom: 92%;">
  <iframe
    src="${SITE_URL}/embed/map/"
    title="EL teacher certification — projectcert"
    loading="lazy"
    style="position: absolute; inset: 0; width: 100%; height: 100%; border: 0;"
    referrerpolicy="no-referrer-when-downgrade"
  ></iframe>
</div>`;
---

<BaseLayout
  title="Embed the map"
  description="Copy-paste iframe code to embed projectcert's interactive U.S. EL teacher certification map on your own site."
>
  <article class="max-w-3xl mx-auto px-4 py-8 prose-sm">
    <h1 class="text-3xl font-bold text-ink">Embed the map</h1>

    <p class="mt-3 text-ink-muted">
      The choropleth at <a href="/map/" class="text-accent hover:underline">projectcert.org/map/</a>
      is embeddable on any site via an <code>&lt;iframe&gt;</code>. The embed
      includes a small attribution line that links back to projectcert.org and
      to the seed paper. Use is permitted under
      <a href="https://creativecommons.org/licenses/by/4.0/" target="_blank" rel="noopener" class="text-accent hover:underline">CC BY 4.0</a>;
      please keep the attribution visible.
    </p>

    <h2 class="mt-8 text-xl font-semibold text-ink">Quick copy-paste</h2>
    <p class="mt-2 text-sm text-ink-muted">
      Drop this anywhere on your page. It will fill the available width and
      keep a fixed height.
    </p>
    <pre class="mt-3 rounded border border-ink-subtle/20 bg-surface-raised p-3 overflow-x-auto text-xs"><code>{basicSnippet}</code></pre>

    <h2 class="mt-8 text-xl font-semibold text-ink">Responsive (recommended)</h2>
    <p class="mt-2 text-sm text-ink-muted">
      Maintains a 10:7 aspect ratio so the map stays readable on phones.
    </p>
    <pre class="mt-3 rounded border border-ink-subtle/20 bg-surface-raised p-3 overflow-x-auto text-xs"><code>{responsiveSnippet}</code></pre>

    <h2 class="mt-8 text-xl font-semibold text-ink">Lock to one layer</h2>
    <p class="mt-2 text-sm text-ink-muted">
      Add <code>?layer=&lt;name&gt;</code> to set the initial encoded variable.
      Visitors can still switch layers within the embed.
    </p>
    <ul class="mt-3 grid grid-cols-1 sm:grid-cols-2 gap-2 text-sm">
      {layers.map((l) => (
        <li class="rounded border border-ink-subtle/20 px-3 py-2">
          <strong class="text-ink">{l.label}</strong>
          <div class="mt-1 text-xs font-mono text-ink-muted break-all">
            {SITE_URL}/embed/map/?layer={l.value}
          </div>
        </li>
      ))}
    </ul>

    <h2 class="mt-8 text-xl font-semibold text-ink">Live preview</h2>
    <p class="mt-2 text-sm text-ink-muted">
      This is exactly what an embedded map looks like on a third-party page:
    </p>
    <div class="mt-3 rounded border border-ink-subtle/20 overflow-hidden">
      <div style="position: relative; width: 100%; padding-bottom: 92%;">
        <iframe
          src="/embed/map/"
          title="Live preview of projectcert map embed"
          loading="lazy"
          style="position: absolute; inset: 0; width: 100%; height: 100%; border: 0;"
        ></iframe>
      </div>
    </div>

    <h2 class="mt-8 text-xl font-semibold text-ink">Notes</h2>
    <ul class="mt-2 text-sm text-ink-muted list-disc pl-5 space-y-1">
      <li>The embed honors the visitor's <code>prefers-color-scheme</code>, so it adapts to light or dark host pages automatically.</li>
      <li>Hovering or focusing a state shows details inside the iframe; clicking opens that state's projectcert page in a new tab.</li>
      <li>If you need a static image instead of an interactive embed, contact us — we can provide a high-resolution SVG.</li>
      <li>Citation: please cite both <a class="text-accent hover:underline" href="/about/#how-to-cite">projectcert</a> and the <a class="text-accent hover:underline" target="_blank" rel="noopener" href="https://doi.org/10.14507/epaa.29.5279">seed paper</a> when you publish.</li>
    </ul>
  </article>
</BaseLayout>
