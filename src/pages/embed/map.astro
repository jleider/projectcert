---
import EmbedLayout from "@/layouts/EmbedLayout.astro";
import MapExplorer from "@/components/MapExplorer.svelte";
import { getChoroplethData, LAYERS, type Layer } from "@/lib/state-data";

const data = await getChoroplethData();

const requested = Astro.url.searchParams.get("layer");
const initialLayer: Layer = (LAYERS as readonly string[]).includes(requested ?? "")
  ? (requested as Layer)
  : "elPercent";

---

<EmbedLayout
  title="EL teacher certification map"
  description="Embeddable map of U.S. state EL teacher certification data."
>
  <MapExplorer
    client:only="svelte"
    states={data}
    initialLayer={initialLayer}
    embedFooter={true}
  />
</EmbedLayout>
