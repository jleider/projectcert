---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { CANONICAL_TERMS, STUDENT_TERM_ALIASES, STATE_LOCAL_NAMES } from "@/data/terminology";
import { STATES } from "@/data/states-meta";
import { SITE_URL } from "@/config/site";
import StateLink from "@/components/StateLink.astro";
import { breadcrumbWithHome } from "@/lib/jsonld";

// Render state-local names in alphabetical order by state name, with
// the canonical state name visible alongside the USPS code so users
// don't have to know that "MS" is Mississippi vs. Missouri.
const stateLocalRows = STATES
  .map((meta) => ({
    usps: meta.usps,
    name: meta.name,
    names: STATE_LOCAL_NAMES[meta.usps],
  }))
  .filter((r) => r.names);

const glossaryUrl = `${SITE_URL}/glossary/`;
const definedTerms = CANONICAL_TERMS.map((t) => ({
  "@type": "DefinedTerm",
  "@id": `${glossaryUrl}#${t.canonical}`,
  name: t.canonical,
  alternateName: t.aliases,
  ...(t.notes && { description: t.notes }),
  inDefinedTermSet: { "@id": `${glossaryUrl}#termset` },
}));
const glossaryJsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "DefinedTermSet",
    "@id": `${glossaryUrl}#termset`,
    name: "projectcert glossary",
    description:
      "Canonical terminology used across projectcert for English Learner (EL) teacher certification, with state-local aliases.",
    url: glossaryUrl,
    inLanguage: "en-US",
    hasDefinedTerm: definedTerms,
  },
  breadcrumbWithHome([{ name: "Glossary", url: glossaryUrl }]),
];
---

<BaseLayout
  title="Glossary"
  description="Canonical terminology and state-local aliases used across projectcert."
  jsonLd={glossaryJsonLd}
>
  <article class="max-w-3xl mx-auto px-4 py-8">
    <h1 class="text-3xl font-bold text-ink">Glossary</h1>
    <p class="mt-2 text-ink-muted">
      Every state names things differently. To keep cross-state
      comparison meaningful, we normalize SEA wording to a canonical
      taxonomy.
    </p>

    <h2 class="mt-8 text-xl font-semibold text-ink">Student term</h2>
    <table class="mt-3 min-w-full text-sm">
      <thead class="text-left bg-surface-raised">
        <tr>
          <th class="px-3 py-2 font-semibold text-ink">Code</th>
          <th class="px-3 py-2 font-semibold text-ink">Expansion</th>
          <th class="px-3 py-2 font-semibold text-ink">Canonical?</th>
        </tr>
      </thead>
      <tbody>
        {STUDENT_TERM_ALIASES.map((t) => (
          <tr class="border-t border-ink-subtle/20">
            <td class={`px-3 py-2 ${t.canonical ? "font-semibold text-accent" : "text-ink-muted"}`}>{t.code}</td>
            <td class="px-3 py-2 text-ink-muted">{t.expansion}</td>
            <td class="px-3 py-2 text-ink-muted">{t.canonical ? "Yes — used in site copy" : "Recorded in source quotes only"}</td>
          </tr>
        ))}
      </tbody>
    </table>

    <h2 class="mt-10 text-xl font-semibold text-ink">Credentials and program types</h2>
    <dl class="mt-3 space-y-3">
      {CANONICAL_TERMS.map((t) => (
        <div>
          <dt class="font-semibold text-ink">{t.canonical}</dt>
          <dd class="text-ink-muted">
            Aliases: {t.aliases.join(", ")}.
            {t.notes && <span class="italic"> {t.notes}</span>}
          </dd>
        </div>
      ))}
    </dl>

    <h2 class="mt-10 text-xl font-semibold text-ink">State-local names</h2>
    <p class="mt-2 text-ink-muted">
      How each of the 51 SEAs labels its own credentials. Click a state
      name for the full per-state record. A dash means the credential
      type isn't offered (bilingual) or isn't mandated for all teachers
      (SEI).
    </p>
    <div class="mt-3 overflow-x-auto">
      <table class="min-w-full text-sm">
        <thead class="text-left bg-surface-raised">
          <tr>
            <th scope="col" class="px-3 py-2 font-semibold text-ink">State</th>
            <th scope="col" class="px-3 py-2 font-semibold text-ink">Bilingual</th>
            <th scope="col" class="px-3 py-2 font-semibold text-ink">ELD</th>
            <th scope="col" class="px-3 py-2 font-semibold text-ink">SEI mandate</th>
          </tr>
        </thead>
        <tbody>
          {stateLocalRows.map((r) => (
            <tr class="border-t border-ink-subtle/20">
              <th scope="row" class="px-3 py-2 font-semibold text-ink whitespace-nowrap">
                <StateLink usps={r.usps}>{r.name}</StateLink>
                <span class="ml-1 text-xs text-ink-subtle font-normal">({r.usps})</span>
              </th>
              <td class="px-3 py-2 text-ink-muted">{r.names!.bilingual ?? "—"}</td>
              <td class="px-3 py-2 text-ink-muted">{r.names!.eld ?? "—"}</td>
              <td class="px-3 py-2 text-ink-muted">{r.names!.sei ?? "—"}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="mt-3 text-xs text-ink-subtle">
      Names sourced from Leider et al. (2021) Appendix A document
      titles where explicitly documented; otherwise the most common SEA
      wording for that credential type. Per-state pages will supersede
      these as states are re-verified to <code>verified-2026</code>.
    </p>
  </article>
</BaseLayout>
