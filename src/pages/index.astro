---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Choropleth from "@/components/Choropleth.svelte";
import ChoroplethLegend from "@/components/ChoroplethLegend.astro";
import CitationBlock from "@/components/CitationBlock.astro";
import StateLink from "@/components/StateLink.astro";
import StateSeal from "@/components/StateSeal.astro";
import { getChoroplethData, getAllStates, absoluteStateUrl } from "@/lib/state-data";
import { SITE_URL } from "@/config/site";

const data = await getChoroplethData();
const states = await getAllStates();

const totalEls = states.reduce((sum, s) => sum + s.elPercent, 0);
const meanEl = totalEls / states.length;
const bilingualOffered = states.filter((s) => s.credentials.bilingual.offered).length;
const eldStandalone = states.filter((s) => s.credentials.eld.standalone).length;
const seiMandated = states.filter((s) => s.credentials.sei.mandatedForAllTeachers).length;
const standardsMentionEl = states.filter((s) => s.professionalStandardsMentions.el).length;

const latestVerified = states
  .map((s) => s.lastVerified)
  .sort()
  .at(-1) ?? "2026-01-01";

const homeJsonLd = {
  "@context": "https://schema.org",
  "@type": "DataCatalog",
  "@id": `${SITE_URL}/#datacatalog`,
  name: "projectcert — EL teacher certification atlas",
  description:
    "Per-state teacher certification requirements for instructing classified English Learner (EL) students across all 50 U.S. states plus the District of Columbia.",
  url: SITE_URL,
  inLanguage: "en-US",
  license: "https://creativecommons.org/licenses/by/4.0/",
  publisher: { "@id": `${SITE_URL}/#organization` },
  isAccessibleForFree: true,
  keywords: [
    "English Learner",
    "EL",
    "ELL",
    "bilingual education",
    "ESL",
    "ELD",
    "teacher certification",
    "teacher licensure",
    "state education agency",
    "SEA",
  ],
  dataset: states.map((s) => ({
    "@type": "Dataset",
    "@id": `${absoluteStateUrl(SITE_URL, s.usps)}#dataset`,
    name: `${s.name} EL teacher certification`,
    url: absoluteStateUrl(SITE_URL, s.usps),
    dateModified: s.lastVerified,
  })),
};
---

<BaseLayout
  title="EL teacher certification across U.S. states"
  description="An atlas of every U.S. state education agency's teacher certification requirements for instructing classified English Learner students."
  jsonLd={homeJsonLd}
>
  <section class="max-w-6xl mx-auto px-4 py-10">
    <h1 class="text-3xl sm:text-4xl font-bold text-ink max-w-3xl">
      A 51-state atlas of teacher certification requirements for instructing classified English Learners.
    </h1>
    <p class="mt-4 text-lg text-ink-muted max-w-3xl">
      Every state education agency interprets the same federal civil-rights protections differently. This site catalogs how — what credentials they offer, what those credentials require, and whether their professional teaching standards even acknowledge ELs.
    </p>
    <p class="mt-3">
      <a
        href="#cite-this-page"
        class="text-sm text-accent hover:underline focus-visible:underline"
      >Cite this site &darr;</a>
    </p>

    <div class="mt-8">
      <Choropleth client:only="svelte" states={data} layer="elPercent" />
      <div class="mt-3">
        <ChoroplethLegend variant="elPercent" />
      </div>
      <p class="mt-2 text-sm text-ink-subtle">
        Hover or focus a state to see its details. Click to open the per-state page.
      </p>
    </div>

    <ul class="mt-10 grid grid-cols-2 sm:grid-cols-4 gap-4" aria-label="Key statistics">
      <li class="rounded border border-ink-subtle/20 p-4">
        <div class="text-2xl font-bold text-ink">{bilingualOffered}<span class="text-ink-subtle">/51</span></div>
        <div class="text-sm text-ink-muted">states offer a bilingual education credential</div>
      </li>
      <li class="rounded border border-ink-subtle/20 p-4">
        <div class="text-2xl font-bold text-ink">{eldStandalone}<span class="text-ink-subtle">/51</span></div>
        <div class="text-sm text-ink-muted">offer ELD as a standalone certification</div>
      </li>
      <li class="rounded border border-ink-subtle/20 p-4">
        <div class="text-2xl font-bold text-ink">{seiMandated}<span class="text-ink-subtle">/51</span></div>
        <div class="text-sm text-ink-muted">mandate SEI training for all teachers</div>
      </li>
      <li class="rounded border border-ink-subtle/20 p-4">
        <div class="text-2xl font-bold text-ink">{standardsMentionEl}<span class="text-ink-subtle">/51</span></div>
        <div class="text-sm text-ink-muted">teaching standards explicitly reference ELs</div>
      </li>
    </ul>

    <nav class="mt-10 grid sm:grid-cols-3 gap-4" aria-label="Explore">
      <a href="/map/" class="rounded border border-ink-subtle/20 p-4 hover:bg-surface-raised hover:border-accent">
        <h2 class="font-semibold text-ink">Explore the map</h2>
        <p class="text-sm text-ink-muted mt-1">Switch between EL population, bilingual, ELD, SEI, and standards layers.</p>
      </a>
      <a href="/credentials/bilingual/" class="rounded border border-ink-subtle/20 p-4 hover:bg-surface-raised hover:border-accent">
        <h2 class="font-semibold text-ink">Read the credential reports</h2>
        <p class="text-sm text-ink-muted mt-1">Topical deep-dives on bilingual, ELD, and SEI credentialing.</p>
      </a>
      <a href="/compare/" class="rounded border border-ink-subtle/20 p-4 hover:bg-surface-raised hover:border-accent">
        <h2 class="font-semibold text-ink">Compare states</h2>
        <p class="text-sm text-ink-muted mt-1">Pick two to four states and see their requirements side by side.</p>
      </a>
    </nav>

    <p class="mt-10 text-sm text-ink-subtle">
      National mean: {meanEl.toFixed(1)}% classified ELs (51-SEA average, 2019 baseline).
    </p>

    <section class="mt-12" aria-labelledby="all-states-heading">
      <h2 id="all-states-heading" class="text-xl font-semibold text-ink">All 51 jurisdictions</h2>
      <p class="mt-1 text-sm text-ink-muted">
        Each card links to the full per-state record with credentials, standards, sources, and policy timeline.
      </p>
      <ul class="mt-4 grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-2">
        {states.map((s) => (
          <li>
            <a
              href={`/states/${s.usps.toLowerCase()}/`}
              class="flex items-center gap-3 rounded border border-ink-subtle/20 px-3 py-2 hover:bg-surface-raised hover:border-accent"
            >
              <StateSeal usps={s.usps} size={36} />
              <span class="flex-1 min-w-0">
                <span class="block font-medium text-ink truncate">{s.name}</span>
                <span class="block text-xs text-ink-subtle">{s.usps} · {s.elPercent.toFixed(1)}% EL</span>
              </span>
            </a>
          </li>
        ))}
      </ul>
    </section>

    <CitationBlock
      title="projectcert: a 51-state atlas of EL teacher certification"
      dateModified={latestVerified}
      url={`${SITE_URL}/`}
      bibKey={`projectcert_${latestVerified.slice(0, 4)}`}
    />
  </section>
</BaseLayout>
