---
import { getCollection, type CollectionEntry } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import CredentialPanel from "@/components/CredentialPanel.astro";
import SourceList from "@/components/SourceList.astro";
import VerificationBadge from "@/components/VerificationBadge.astro";
import StateSeal from "@/components/StateSeal.astro";
import ExternalLink from "@/components/ExternalLink.astro";
import ReportIssue from "@/components/ReportIssue.astro";
import ShareLinks from "@/components/ShareLinks.astro";
import HistoryTimeline from "@/components/HistoryTimeline.astro";
import CitationBlock from "@/components/CitationBlock.astro";
import { STATE_LOCAL_NAMES } from "@/data/terminology";
import { leadParagraph, metaDescription, pageTitle } from "@/lib/state-summary";
import { SITE_URL } from "@/config/site";
import { breadcrumbWithHome } from "@/lib/jsonld";
import { ROUTES, ANCHORS, sameAnchor } from "@/lib/routes";
import { absoluteStateUrl } from "@/lib/state-data";

export async function getStaticPaths() {
  const entries = await getCollection("states");
  return entries.map((entry) => ({
    params: { usps: entry.data.usps.toLowerCase() },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<"states">;
}

const { entry } = Astro.props;
const s = entry.data;
const localNames = STATE_LOCAL_NAMES[s.usps];

const standardsCount = Object.values(s.professionalStandardsMentions).filter(Boolean).length;

const stateUrl = absoluteStateUrl(SITE_URL, s.usps);
const lead = leadParagraph(s);
const stateJsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Dataset",
    "@id": `${stateUrl}#dataset`,
    name: `${s.name} EL teacher certification`,
    description: lead,
    url: stateUrl,
    inLanguage: "en-US",
    isAccessibleForFree: true,
    license: "https://creativecommons.org/licenses/by/4.0/",
    dateModified: s.lastVerified,
    temporalCoverage: `${s.elPercentAsOf}/${s.lastVerified}`,
    spatialCoverage: {
      "@type": "AdministrativeArea",
      name: s.name,
      identifier: s.usps,
    },
    creator: { "@id": `${SITE_URL}/#organization` },
    publisher: { "@id": `${SITE_URL}/#organization` },
    citation: "https://doi.org/10.14507/epaa.29.5279",
    keywords: [
      `${s.name} bilingual education credential`,
      `${s.name} ESL endorsement`,
      `${s.name} ELD endorsement`,
      `${s.name} teacher licensure`,
      "English Learner",
      "EL teacher certification",
    ],
  },
  breadcrumbWithHome([
    { name: "States", url: ROUTES.home },
    { name: s.name, url: stateUrl },
  ]),
];
---

<BaseLayout
  title={pageTitle(s)}
  description={metaDescription(s)}
  type="article"
  modifiedTime={s.lastVerified}
  jsonLd={stateJsonLd}
  citation={{
    title: `${s.name} EL teacher certification`,
    publicationDate: s.lastVerified,
    publicUrl: stateUrl,
  }}
>
  <article class="max-w-4xl mx-auto px-4 py-8">
    <p class="text-sm text-ink-muted">
      <a href={ROUTES.home} class="text-accent hover:underline">All states</a> /
      <span aria-current="page">{s.name}</span>
    </p>

    <div class="mt-2 flex items-center gap-5">
      <StateSeal usps={s.usps} size={96} />
      <h1 class="text-4xl font-bold text-ink">{s.name}</h1>
    </div>

    <div class="mt-3 flex flex-wrap gap-3 items-center">
      <VerificationBadge status={s.verificationStatus} lastVerified={s.lastVerified} />
      <a
        href={sameAnchor(ANCHORS.citeThisPage)}
        class="text-xs text-accent hover:underline focus-visible:underline"
      >Cite this page &darr;</a>
    </div>

    <p class="mt-5 text-base text-ink-muted max-w-3xl">{lead}</p>

    <section class="mt-6 grid sm:grid-cols-3 gap-4" aria-label="At a glance">
      <div class="rounded border border-ink-subtle/20 p-4">
        <div class="text-2xl font-bold text-ink">{s.elPercent.toFixed(1)}%</div>
        <div class="text-sm text-ink-muted">classified ELs ({s.elPercentAsOf})</div>
      </div>
      <div class="rounded border border-ink-subtle/20 p-4">
        <div class="text-2xl font-bold text-ink">
          {[s.credentials.bilingual.offered ? "Bil" : null, s.credentials.eld.offered ? "ELD" : null, s.credentials.sei.mandatedForAllTeachers ? "SEI" : null].filter(Boolean).join(" + ") || "ELD only"}
        </div>
        <div class="text-sm text-ink-muted">credential types offered</div>
      </div>
      <div class="rounded border border-ink-subtle/20 p-4">
        <div class="text-2xl font-bold text-ink">{standardsCount}<span class="text-ink-subtle">/4</span></div>
        <div class="text-sm text-ink-muted">standards-mention categories</div>
      </div>
    </section>

    <h2 class="mt-10 text-xl font-semibold text-ink">Credentials</h2>

    <div class="mt-4 grid md:grid-cols-2 gap-4">
      <CredentialPanel
        title={localNames?.bilingual ?? "Bilingual education"}
        credential={s.credentials.bilingual}
        showLanguage={true}
      />
      <CredentialPanel
        title={localNames?.eld ?? "English Language Development (ELD)"}
        credential={s.credentials.eld}
      />
    </div>

    <section class="mt-6 rounded border border-ink-subtle/20 p-4" aria-labelledby="sei-heading">
      <h3 id="sei-heading" class="text-base font-semibold text-ink">{localNames?.sei ?? "Sheltered English Instruction (SEI)"}</h3>
      <p class="mt-2 text-sm text-ink-muted">
        {s.credentials.sei.mandatedForAllTeachers
          ? "Mandated for all teachers."
          : "Not mandated for all teachers."}
      </p>
      {s.credentials.sei.notes && (
        <p class="mt-2 text-sm text-ink-muted italic">{s.credentials.sei.notes}</p>
      )}
    </section>

    <h2 class="mt-10 text-xl font-semibold text-ink">Professional teaching standards</h2>
    <p class="mt-1 text-sm text-ink-muted">Does the SEA's professional teaching standards document explicitly reference these categories?</p>

    <ul class="mt-3 grid grid-cols-2 sm:grid-cols-4 gap-2 text-sm">
      <li class={`p-3 rounded border ${s.professionalStandardsMentions.diverse ? "border-accent/40 text-accent" : "border-ink-subtle/20 text-ink-subtle"}`}>
        <strong>Diverse / all</strong>
        <div>{s.professionalStandardsMentions.diverse ? "Yes" : "No"}</div>
      </li>
      <li class={`p-3 rounded border ${s.professionalStandardsMentions.cultural ? "border-accent/40 text-accent" : "border-ink-subtle/20 text-ink-subtle"}`}>
        <strong>Cultural</strong>
        <div>{s.professionalStandardsMentions.cultural ? "Yes" : "No"}</div>
      </li>
      <li class={`p-3 rounded border ${s.professionalStandardsMentions.linguistic ? "border-accent/40 text-accent" : "border-ink-subtle/20 text-ink-subtle"}`}>
        <strong>Linguistic</strong>
        <div>{s.professionalStandardsMentions.linguistic ? "Yes" : "No"}</div>
      </li>
      <li class={`p-3 rounded border ${s.professionalStandardsMentions.el ? "border-accent/40 text-accent" : "border-ink-subtle/20 text-ink-subtle"}`}>
        <strong>ELs explicit</strong>
        <div>{s.professionalStandardsMentions.el ? "Yes" : "No"}</div>
      </li>
    </ul>

    <h2 class="mt-10 text-xl font-semibold text-ink">State policy signals</h2>

    <div class="mt-3 grid sm:grid-cols-2 gap-3">
      <section class="rounded border border-ink-subtle/20 p-4" aria-labelledby="seal-heading">
        <h3 id="seal-heading" class="text-base font-semibold text-ink">Seal of Biliteracy</h3>
        <p class="mt-1 text-sm text-ink-muted">
          Recognition for graduating students proficient in English plus another language.
        </p>
        <p class="mt-2 text-sm">
          {s.sealOfBiliteracy.adopted ? (
            <span class="text-accent">
              <strong>Adopted</strong>{s.sealOfBiliteracy.year && <> in {s.sealOfBiliteracy.year}</>}.
            </span>
          ) : (
            <span class="text-ink-subtle"><strong>Not adopted.</strong></span>
          )}
        </p>
        <p class="mt-2 text-xs text-ink-subtle">
            Source: <ExternalLink href={s.sealOfBiliteracy.sourceUrl} class="text-accent hover:underline">sealofbiliteracy.org</ExternalLink>
        </p>
      </section>

      <section class="rounded border border-ink-subtle/20 p-4" aria-labelledby="elp-heading">
        <h3 id="elp-heading" class="text-base font-semibold text-ink">ELP assessment</h3>
        <p class="mt-1 text-sm text-ink-muted">
          Annual English Language Proficiency test used for EL identification and reclassification.
        </p>
        <p class="mt-2 text-sm">
          <span class={s.elpAssessment.consortium === "WIDA" ? "text-accent" : "text-ink-muted"}>
            <strong>{s.elpAssessment.name}</strong>
          </span>
          {s.elpAssessment.consortium === "WIDA" && <> · WIDA Consortium member.</>}
          {s.elpAssessment.consortium === "ELPA21" && <> · ELPA21 consortium member.</>}
          {s.elpAssessment.consortium === null && <> · State-specific assessment.</>}
        </p>
        {s.elpAssessment.sourceUrl && (
          <p class="mt-2 text-xs text-ink-subtle">
            Source: <ExternalLink href={s.elpAssessment.sourceUrl} class="text-accent hover:underline">{new URL(s.elpAssessment.sourceUrl).hostname}</ExternalLink>
          </p>
        )}
      </section>
    </div>

    {s.history && s.history.length > 0 && (
      <HistoryTimeline events={s.history} />
    )}

    <SourceList sources={s.sources} />

    <CitationBlock
      title={`${s.name} EL teacher certification`}
      dateModified={s.lastVerified}
      url={stateUrl}
      bibKey={`projectcert_${s.usps.toLowerCase()}_${s.lastVerified.slice(0, 4)}`}
    />

    <ReportIssue
      variant="inline"
      state={s.usps}
      pageType="state"
      verificationStatus={s.verificationStatus}
    />

    <ShareLinks
      url={stateUrl}
      text={`${s.name} EL teacher certification — projectcert`}
    />

    <p class="mt-8 text-sm text-ink-subtle">
      See the <a class="text-accent hover:underline" href={ROUTES.methodology}>methodology</a> for how these data were collected, or the <a class="text-accent hover:underline" href={ROUTES.glossary}>glossary</a> for term definitions.
    </p>
  </article>
</BaseLayout>
