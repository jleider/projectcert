---
import { getCollection, type CollectionEntry } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import ElPercentChart from "@/components/ElPercentChart.astro";
import StateSeal from "@/components/StateSeal.astro";
import ExternalLink from "@/components/ExternalLink.astro";
import { SITE_URL } from "@/config/site";
import { breadcrumbWithHome } from "@/lib/jsonld";
import { ROUTES } from "@/lib/routes";
import { absoluteElPercentHistoryUrl, absoluteStateUrl, stateUrl } from "@/lib/state-data";

export async function getStaticPaths() {
  const entries = await getCollection("states");
  return entries.map((entry) => ({
    params: { usps: entry.data.usps.toLowerCase() },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<"states">;
}

const { entry } = Astro.props;
const s = entry.data;

const history = s.elPercentHistory ?? [];
const stateAbs = absoluteStateUrl(SITE_URL, s.usps);
const pageAbs = absoluteElPercentHistoryUrl(SITE_URL, s.usps);

// Unique source labels for the citation footnote.
const sourceMap = new Map<string, string>();
for (const obs of history) {
  if (!sourceMap.has(obs.source.url)) {
    sourceMap.set(obs.source.url, obs.source.label);
  }
}

const ncesRows = history.filter((d) => d.source.publisher === "nces");
const seaRows = history.filter((d) => d.source.publisher === "sea");
const lastNcesYear = ncesRows.length > 0 ? ncesRows[ncesRows.length - 1]!.date.slice(0, 4) : null;
const lastSeaYear = seaRows.length > 0 ? seaRows[seaRows.length - 1]!.date.slice(0, 4) : null;

const title = `${s.name}: classified-EL share over time | projectcert`;
const description = `Annual share of public-school students classified as English Learners in ${s.name}, ${history[0]?.date.slice(0, 4) ?? ""}–${history[history.length - 1]?.date.slice(0, 4) ?? ""}.`;

const jsonLd = [
  breadcrumbWithHome([
    { name: "States", url: ROUTES.home },
    { name: s.name, url: stateAbs },
    { name: "Classified-EL share over time", url: pageAbs },
  ]),
];
---

<BaseLayout title={title} description={description} type="article" modifiedTime={s.lastVerified} jsonLd={jsonLd}>
  <article class="max-w-4xl mx-auto px-4 py-8">
    <p class="text-sm text-ink-muted">
      <a href={ROUTES.home} class="text-accent hover:underline">All states</a> /
      <a href={stateUrl(s.usps)} class="text-accent hover:underline">{s.name}</a> /
      <span aria-current="page">Classified-EL share over time</span>
    </p>

    <div class="mt-2 flex items-center gap-5">
      <StateSeal usps={s.usps} size={72} />
      <div>
        <h1 class="text-3xl font-bold text-ink">
          {s.name}: classified-EL share over time
        </h1>
        <p class="mt-1 text-sm text-ink-muted">
          Annual share of public-school students classified as English Learners.
        </p>
      </div>
    </div>

    {
      history.length > 0 ? (
        <ElPercentChart data={history} stateName={s.name} />
      ) : (
        <p class="mt-6 text-sm text-ink-muted">No historical observations are recorded for {s.name} yet.</p>
      )
    }

    <section class="mt-8" aria-labelledby="about-figure">
      <h2 id="about-figure" class="text-base font-semibold text-ink">About this figure</h2>
      <p class="mt-2 text-sm text-ink-muted">
        Each point is the fall-enrollment share of students classified as English Learners in {s.name}'s public schools.
        Observations through fall {lastNcesYear} are drawn from the National Center for Education Statistics (NCES) Digest
        of Education Statistics, Table 204.20, the canonical national series; NCES has not yet republished this table for
        school years after 2021-22.
        {
          lastSeaYear ? (
            <>
              For fall {lastSeaYear}, the catalog falls back to figures published directly by the {s.name} state
              education agency. State-agency methodology may differ from NCES — the methodology note above the data
              table records the difference, and the dashed line and hollow markers in the chart mark the boundary.
            </>
          ) : (
            <>
              Per-state dashboards sometimes carry more recent figures, but they are not directly comparable across
              states without methodology checks; the catalog adds them only when the agency's definition and denominator
              can be documented.
            </>
          )
        }
      </p>
      {
        sourceMap.size > 0 && (
          <p class="mt-3 text-sm text-ink-muted">
            Source{sourceMap.size > 1 ? "s" : ""}:{" "}
            {[...sourceMap.entries()].map(([url, label], i) => (
              <>
                {i > 0 && "; "}
                <ExternalLink href={url} class="text-accent hover:underline">
                  {label}
                </ExternalLink>
              </>
            ))}
            .
          </p>
        )
      }
    </section>

    <p class="mt-10 text-sm">
      <a href={stateUrl(s.usps)} class="text-accent hover:underline">&larr; Back to {s.name}</a>
    </p>
  </article>
</BaseLayout>
