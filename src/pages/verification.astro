---
import BaseLayout from "@/layouts/BaseLayout.astro";
import StateLink from "@/components/StateLink.astro";
import { getAllStates } from "@/lib/state-data";
import { verificationDisplay } from "@/lib/verification-display";

const states = await getAllStates();

/**
 * Grouped by what is actually true of each record, not by the stored enum:
 * a state counts as fully verified only once a reviewer has confirmed every
 * displayed detail. See `src/lib/verification-display.ts`.
 */
const withView = states.map((s) => ({
  state: s,
  view: verificationDisplay({ usps: s.usps, verificationStatus: s.verificationStatus, lastVerified: s.lastVerified }),
}));

const groups = {
  "fully-verified": withView.filter((x) => x.view.stage === "fully-verified"),
  "sources-checked": withView.filter((x) => x.view.stage === "sources-checked"),
  "check-in-progress": withView.filter((x) => x.view.stage === "check-in-progress"),
  baseline: withView.filter((x) => x.view.stage === "baseline"),
};

const totalDetails = withView[0]?.view.progress.total ?? 0;
const confirmedDetails = withView.reduce((n, x) => n + x.view.progress.confirmed, 0);
const possibleDetails = withView.reduce((n, x) => n + x.view.progress.total, 0);
---

<BaseLayout
  title="How this data is verified"
  description="The two checks behind every state record: a source check against current state education agency documents, and detail-by-detail verification by an authorized reviewer."
>
  <article class="max-w-4xl mx-auto px-4 py-8">
    <h1 class="text-2xl font-bold text-ink">How this data is verified</h1>
    <p class="mt-2 text-ink-muted max-w-3xl">
      Every state record passes two separate checks. Both must be complete before the catalog describes a state as fully
      verified, and this page records where each state stands.
    </p>

    <section class="mt-6 grid sm:grid-cols-2 gap-4">
      <div class="rounded border border-ink-subtle/20 p-4 bg-surface-raised">
        <h2 class="text-base font-semibold text-ink">1. The source check</h2>
        <p class="mt-2 text-sm text-ink-muted">
          A maintainer opens the state education agency's current public documents, re-reads the rules against the same
          coding scheme used for the 2019 published baseline, records every divergence from that baseline in a dated
          note, and archives the documents consulted. This establishes what the agency requires today. It has been
          completed for all {states.length} jurisdictions.
        </p>
      </div>
      <div class="rounded border border-ink-subtle/20 p-4 bg-surface-raised">
        <h2 class="text-base font-semibold text-ink">2. Verification by an authorized reviewer</h2>
        <p class="mt-2 text-sm text-ink-muted">
          A second person — an authorized reviewer, signing in under their own identity — then verifies each of the
          {totalDetails} displayed details separately against the source cited for it. Each verification records who made
          it and when. This is independent of the source check, and is the slower of the two.
        </p>
      </div>
    </section>

    <p class="mt-4 text-sm text-ink-muted max-w-3xl">
      A verification stops counting if the underlying value later changes, or if a cited source becomes unreachable, so
      the figures below describe the record as it stands rather than as it once stood. Across the catalog,
      {confirmedDetails} of {possibleDetails} details are currently verified by an authorized reviewer.
    </p>

    <ul class="mt-6 grid grid-cols-2 sm:grid-cols-4 gap-3 text-sm">
      <li class="rounded border border-accent/30 bg-accent/5 p-3">
        <div class="text-2xl font-bold text-accent">{groups["fully-verified"].length}</div>
        <div class="text-ink-muted">fully verified</div>
      </li>
      <li class="rounded border border-ink-subtle/30 bg-bin-1/20 p-3">
        <div class="text-2xl font-bold text-ink">{groups["sources-checked"].length}</div>
        <div class="text-ink-muted">sources checked, reviewer verification ongoing</div>
      </li>
      <li class="rounded border border-bin-2/40 bg-bin-1/20 p-3">
        <div class="text-2xl font-bold text-ink">{groups["check-in-progress"].length}</div>
        <div class="text-ink-muted">source check in progress</div>
      </li>
      <li class="rounded border border-ink-subtle/30 bg-surface-warn p-3">
        <div class="text-2xl font-bold text-ink">{groups.baseline.length}</div>
        <div class="text-ink-muted">2019 baseline, sources not yet re-checked</div>
      </li>
    </ul>

    {
      (
        [
          {
            stage: "fully-verified",
            heading: "Fully verified",
            blurb: "Sources checked, and every displayed detail verified by an authorized reviewer.",
          },
          {
            stage: "sources-checked",
            heading: "Sources checked, verification by an authorized reviewer ongoing",
            blurb:
              "The agency's current documents have been read and the record re-coded from them. Detail-by-detail verification by an authorized reviewer is still under way.",
          },
          {
            stage: "check-in-progress",
            heading: "Source check in progress",
            blurb: "A re-reading of the agency's current documents is under way.",
          },
          {
            stage: "baseline",
            heading: "2019 baseline, sources not yet re-checked",
            blurb: "Values still derive from the 2019 published document analysis.",
          },
        ] as const
      ).map(({ stage, heading, blurb }) => (
        <section class="mt-8">
          <h2 class="text-lg font-semibold text-ink">{heading}</h2>
          <p class="mt-1 text-sm text-ink-muted max-w-3xl">{blurb}</p>
          {groups[stage].length === 0 ? (
            <p class="mt-2 text-ink-muted">No states.</p>
          ) : (
            <ul class="mt-3 grid grid-cols-2 sm:grid-cols-4 gap-x-4 gap-y-1 text-sm">
              {groups[stage].map(({ state, view }) => (
                <li>
                  <StateLink usps={state.usps}>{state.name}</StateLink>
                  <span class="text-ink-subtle">
                    {" · "}
                    {view.progress.confirmed} of {view.progress.total}
                  </span>
                </li>
              ))}
            </ul>
          )}
        </section>
      ))
    }
  </article>
</BaseLayout>
