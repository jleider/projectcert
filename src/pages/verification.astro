---
import BaseLayout from "@/layouts/BaseLayout.astro";
import StateLink from "@/components/StateLink.astro";
import { getAllStates } from "@/lib/state-data";

const states = await getAllStates();
const groups = {
  "verified-2026": states.filter((s) => s.verificationStatus === "verified-2026"),
  "in-progress": states.filter((s) => s.verificationStatus === "in-progress"),
  "baseline-2019": states.filter((s) => s.verificationStatus === "baseline-2019"),
};
---

<BaseLayout
  title="Verification progress"
  description="Per-state progress on re-verifying teacher certification data against current SEA sources before public launch."
>
  <article class="max-w-4xl mx-auto px-4 py-8">
    <h1 class="text-2xl font-bold text-ink">Verification progress</h1>
    <p class="mt-2 text-ink-muted max-w-3xl">
      Public release is contingent on completion of per-state
      re-verification against current SEA sources, superseding the
      2019 baseline. This page records progress per jurisdiction.
    </p>

    <ul class="mt-6 grid grid-cols-3 gap-3 text-sm">
      <li class="rounded border border-accent/30 bg-accent/5 p-3">
        <div class="text-2xl font-bold text-accent">{groups["verified-2026"].length}</div>
        <div class="text-ink-muted">verified-2026</div>
      </li>
      <li class="rounded border border-bin-2/40 bg-bin-1/20 p-3">
        <div class="text-2xl font-bold text-ink">{groups["in-progress"].length}</div>
        <div class="text-ink-muted">in-progress</div>
      </li>
      <li class="rounded border border-ink-subtle/30 bg-surface-warn p-3">
        <div class="text-2xl font-bold text-ink">{groups["baseline-2019"].length}</div>
        <div class="text-ink-muted">baseline-2019</div>
      </li>
    </ul>

    {(["verified-2026", "in-progress", "baseline-2019"] as const).map((status) => (
      <section class="mt-8">
        <h2 class="text-lg font-semibold text-ink">{status}</h2>
        {groups[status].length === 0 ? (
          <p class="mt-2 text-ink-muted">No states.</p>
        ) : (
          <ul class="mt-3 grid grid-cols-2 sm:grid-cols-4 gap-x-4 gap-y-1 text-sm">
            {groups[status].map((s) => (
              <li>
                <StateLink usps={s.usps}>{s.name}</StateLink>
                <span class="text-ink-subtle"> · {s.lastVerified}</span>
              </li>
            ))}
          </ul>
        )}
      </section>
    ))}

    <section class="mt-10 rounded border border-ink-subtle/20 p-4 bg-surface-raised">
      <h2 class="text-base font-semibold text-ink">Verification procedure</h2>
      <p class="mt-2 text-sm text-ink-muted">
        Each state passes through the <code>state-source-refresh</code>
        workflow: current SEA documents are re-fetched from the URLs
        in the state's <code>sources[]</code>, snapshots are stored
        under <code>sources/&lt;usps&gt;/&lt;date&gt;/</code>, the
        record is re-coded against the schema, divergences from the
        2019 baseline are documented, and the
        <code>verificationStatus</code> field is updated to
        <code>verified-2026</code>. Original 2019 source citations are
        retained as part of the audit trail.
      </p>
    </section>
  </article>
</BaseLayout>
